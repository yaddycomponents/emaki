{
  "name": "emaki",
  "private": true,
  "version": "0.0.0",
  "description": "Films from a JSON file. A local-first CLI + studio for code-as-template motion decks.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "emaki": "node packages/cli/dist/index.js",
    "emaki:dev": "tsx --conditions development packages/cli/src/index.ts",
    "goldens": "tsx --conditions development scripts/goldens.mjs generate",
    "goldens:check": "tsx --conditions development scripts/goldens.mjs check",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@emaki/render": "workspace:*",
    "@emaki/schema": "workspace:*",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
