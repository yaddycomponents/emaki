{
  "name": "@emaki/cli",
  "version": "0.1.0-beta.7",
  "description": "The emaki command line — validate, inspect, and (soon) render decks.",
  "type": "module",
  "bin": {
    "emaki": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx --conditions development src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@emaki/extract": "workspace:*",
    "@emaki/mcp": "workspace:*",
    "@emaki/render": "workspace:*",
    "@emaki/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaddycomponents/emaki.git",
    "directory": "packages/cli"
  },
  "license": "MIT"
}
