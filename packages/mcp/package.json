{
  "name": "@emaki/mcp",
  "version": "0.1.0-beta.1",
  "description": "The Emaki MCP server — validate/propose/apply/render/extract tools, schemas from the same Zod defs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "emaki-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/stdio.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@emaki/extract": "workspace:*",
    "@emaki/render": "workspace:*",
    "@emaki/schema": "workspace:*",
    "@emaki/themes": "workspace:*",
    "@emaki/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaddycomponents/emaki.git",
    "directory": "packages/mcp"
  },
  "license": "MIT"
}
